<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/widget_background" android:padding="14dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_review_widget_text_2" android:textSize="20sp" android:textStyle="bold" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_primary" android:contentDescription="@string/widget_review_widget_contentdescription_2"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center_vertical">
  <ImageButton android:id="@+id/widget_previous" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@drawable/widget_chevron_previous" android:contentDescription="@string/widget_review_widget_contentdescription_5"/>
  <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="@string/widget_review_widget_text_6" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_ink" android:maxLines="2"/>
  <ImageButton android:id="@+id/widget_next" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@drawable/widget_chevron_next" android:contentDescription="@string/widget_review_widget_contentdescription_7"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginBottom="6dp">
  <TextView android:id="@+id/widget_today" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:text="@string/widget_review_widget_text_3" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_primary" android:background="@drawable/widget_button"/>
  <TextView android:id="@+id/widget_tomorrow" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:text="@string/widget_tomorrow" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_primary" android:background="@drawable/widget_button"/>
  <TextView android:id="@+id/widget_next_week" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:gravity="center" android:text="@string/widget_next_week" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_primary" android:background="@drawable/widget_button"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:text="@string/widget_review_widget_text_8" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_muted"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:layout_marginBottom="10dp">
  <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="6dp" android:scrollbars="none"/>
  <LinearLayout android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_card" android:padding="12dp">
   <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_review_widget_text_12" android:textSize="13sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_ink"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/widget_review_widget_text_13" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_muted"/>
  </LinearLayout>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="40dp">
  <TextView android:id="@+id/widget_new_task" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center" android:text="@string/widget_review_widget_text_15" android:textSize="12sp" android:textStyle="bold" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_primary" android:background="@drawable/widget_button"/>
  <TextView android:id="@+id/widget_new_meeting" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="@string/widget_review_widget_text_16" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_ink" android:background="@drawable/widget_card"/>
 </LinearLayout>
</LinearLayout>