<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="68dp" android:orientation="horizontal" android:layoutDirection="rtl" android:gravity="top" android:paddingTop="2dp" android:paddingBottom="2dp">
 <LinearLayout android:id="@+id/widget_day_label" android:layout_width="48dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="3dp" android:importantForAccessibility="noHideDescendants">
  <TextView android:id="@+id/widget_day_weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_muted"/>
  <TextView android:id="@+id/widget_day_number" android:layout_width="36dp" android:layout_height="wrap_content" android:minHeight="30dp" android:gravity="center" android:textSize="20sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_ink"/>
  <TextView android:id="@+id/widget_day_month" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_muted"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_meeting_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="62dp" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_card" android:paddingHorizontal="12dp" android:paddingVertical="10dp">
  <TextView android:id="@+id/widget_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_ink"/>
  <TextView android:id="@+id/widget_row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:fontFamily="@font/vazirmatn_regular" android:textColor="@color/widget_muted"/>
 </LinearLayout>
</LinearLayout>
